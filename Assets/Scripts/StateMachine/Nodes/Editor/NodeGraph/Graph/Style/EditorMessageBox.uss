#editor-message-box 
{
    position: absolute;
    bottom: 10px;
    left: 10px;
    display: flex;
    flex-direction: column-reverse;
}

.message-toast 
{
    background-color: rgba(0, 0, 0, 0.7);
    padding: 3px 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: black;
    opacity: 0;
    margin-bottom: 4px;
    transition: opacity 0.25s ease-in-out;
}

.message-text 
{
    color: white;
    -unity-font-style: bold;
}

.info 
{
    background-color: rgba(40, 120, 255, 0.8);
}

.warning 
{
    background-color: rgba(255, 200, 0, 0.85);
}

.error 
{
    background-color: rgba(200, 0, 0, 0.85);
}

.success 
{
    background-color: rgba(0, 200, 100, 0.85);
}
