.graph-tab-root 
{
    padding: 0px;
    margin: 0px;
    overflow: hidden;
}


/* Base style for the tab button */
.graph-tab-button
{
    background-color: #555555;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 0px;
    border-color: #03a1fc;
    padding-left: 10px;
    padding-right: 10px;
    height: 25px;
    margin-right: -2px;
    color: black;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    border-radius: 4px 4px 0 0;
}

/* Style for the selected tab */
.graph-tab-button--selected 
{
    background-color: #333333;
    border-color: #00ffff;
    color: #ffffff;
    border-bottom-color: transparent;
    border-radius: 4px 4px 0 0;
    border-bottom-width: 0;
}

/* Optional hover effect */
.graph-tab-button:hover 
{
    background-color: #666666;
}

/* NodeGraphView.uss */
.graph-grid 
{
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    overflow: hidden;
    background-color: transparent;
}

#grid-layer 
{
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    overflow: hidden;
}

#edge-layer,
#node-layer,
#overlay-layer 
{
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}


.graph-content-container
{
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    overflow: hidden;
}

/* Style for the graph view with a border */
.graph-view 
{
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: #03a1fc;
    border-radius: 4px;
    margin-top: -2px;
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
}

/* Flat shaded toolbar style */
.toolbar-layer 
{
    background-color: #2c2c2c;
    border-bottom-width: 1px;
    border-bottom-color: #444;

    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;

    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* Add margin between File and Layer group */
.toolbar-spacer 
{
    width: 16px;
    flex-grow: 1;
}

.tabs-layer 
{
    margin-top: 4px;
}

#selection-box 
{
    background-color: rgba(77, 144, 254, 0.15);
    border-width: 4px;
    border-color: rgb(77, 144, 254);
    border-radius: 4px;
}
