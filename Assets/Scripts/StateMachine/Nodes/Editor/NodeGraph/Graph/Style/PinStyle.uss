.reroute-pin
{
    width: 12px;
    height: 12px;
    position: absolute;
    overflow: visible;
}

.reroute-dot 
{
    width: 30px;
    height: 30px;
    background-color: rgb(34, 34, 34);
    border-radius: 50%;
    margin: 2px 6px;  
    flex-shrink: 0;
    border-width: 4px;
    border-color: rgb(70, 150, 230);
    transition: border-color 0.1s ease-in-out;

}

.reroute-anchor 
{
    width: 12px;
    height: 12px;
    border-radius: 60%;
    position: absolute;
    border-width: 2px;
    background-color: rgb(0, 180, 100);
    border-color: rgb(20, 40, 20);
}

.pin-input 
{
    background-color: rgb(0, 140, 255);
}

/* Output role (orange) */
.pin-output 
{
    background-color: rgb(255, 140, 0);
}

/* Optional fallback (neutral gray if needed) */
.pin-inactive 
{
    background-color: rgb(80, 80, 80);
}


 .reroute-dot.pin-selected 
 {
    border-color: rgb(255, 204, 0);
}

.connector-cap 
{
    width: 100%;
    height: 100%;
    border-radius: 4px;
    background-color: transparent;
}

.anchor-left 
{
    left: 6px;
    top: 10.5px;
}

.anchor-right 
{
    left: 25px;
    top: 10.5px;
}
