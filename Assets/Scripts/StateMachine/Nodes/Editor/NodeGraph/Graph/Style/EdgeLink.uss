/* General Edge Styling */
.edge-element 
{
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 0px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
}

.edge-element 
{
    --stroke-color: rgb(60, 255, 60);
    --stroke-width: 5;
}


.edge-element.edge-selected 
{
    --stroke-color: rgb(255, 255, 0);
}

.edge-element.edge-hovered 
{
    --stroke-color: rgb(0, 200, 255);
}

/* Bezier Curve Edge */
.bezier-edge 
{
    position: absolute;
    width: 100%;
    height: 100%;
    border-width: 2px;
    border-color: rgb(60, 255, 60);
    transition: border-color 0.15s ease-in-out, opacity 0.1s ease-in-out;
}

/* Edge Selection State */
.edge-default 
{
    border-top-color: rgb(60, 255, 60);
}

/* Selected Edge Style */
.edge-selected 
{
    --stroke-color: rgb(255, 255, 0);
    --stroke-width: 6;
}


.edge-hovered
{
    --stroke-color: rgb(0, 200, 255);
}

.edge-floating 
{
    --stroke-color: #5FD4FF;
    --stroke-width: 5;
}

/* Edge Hover Effect */
.bezier-edge:hover 
{
    opacity: 0.8;
}

.edge-floating 
{
    opacity: 0.7;
     border-top-color: #5FD4FF;
}


/* Edge Glow Effect */
.edge-glow 
{
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(60, 255, 60, 0.4);
    opacity: 0.4;
    transition: opacity 0.1s ease-in-out;
}
